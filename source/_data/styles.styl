.back-to-top {
  right: $b2t-position-right;
  left: auto;

  +tablet-mobile() {
    right: $b2t-position-right-mobile;
    left: auto;
  }
}

+tablet-mobile() {
  .sidebar-toggle {
    bottom: $b2t-position-bottom-on;
  }
}

.code-lang {
  font-size: 12px;
  line-height: 1.6;
  opacity: 0.55;
  right: 8px;
  top: 6px;
  padding: 0 8px;
  border-radius: 10px;
  background: rgba(127, 127, 127, 0.15);
  letter-spacing: 0.5px;
  text-transform: lowercase;   /* 顺带把 JSON 显示成 json；去掉这行就是大写 */
  right: 40px
}

// 图组内打了 no-crop 标记的图片：完整显示，不裁剪
.group-picture .group-picture-column img.no-crop {
  object-fit: contain;
}

// 超宽公式：在自己的框里横向滚动，不撑破页面布局
.katex-display {
  overflow-x: auto;
  overflow-y: hidden;
  padding-bottom: 4px;
}

.katex-display::-webkit-scrollbar {
  height: 6px;
}
.katex-display::-webkit-scrollbar-thumb {
  background: rgba(127, 127, 127, .3);
  border-radius: 3px;
}

// 溢出公式的两侧渐隐提示（随滚动状态出现/消失）
.katex-block.kx-overflow {
  position: relative;
}
.katex-block.kx-overflow::after,
.katex-block.kx-overflow::before {
  content: '';
  pointer-events: none;
  position: absolute;
  top: 0;
  bottom: 0;
  width: 28px;
  transition: opacity 0.15s ease;
}

// 右缘：右边还有没看完的内容时显示
.katex-block.kx-overflow::after {
  background: linear-gradient(to right, transparent, var(--content-bg-color));
  right: 0;
}

// 拖到最右端 → 右缘渐隐淡出
.katex-block.kx-overflow.kx-at-end::after {
  opacity: 0;
}

// 左缘（可选）：已经向右滑过、左边有内容被藏起来时显示
.katex-block.kx-overflow::before {
  background: linear-gradient(to left, transparent, var(--content-bg-color));
  left: 0;
  opacity: 0;
}
.katex-block.kx-overflow:not(.kx-at-start)::before {
  opacity: 1;
}
