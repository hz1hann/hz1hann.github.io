.back-to-top {
  right: $b2t-position-right;
  left: auto;

  +tablet-mobile() {
    right: $b2t-position-right-mobile;
    left: auto;
  }
}

+tablet-mobile() {
  .sidebar-toggle {
    bottom: $b2t-position-bottom-on;
  }
}

.code-lang {
  font-size: 12px;
  line-height: 1.6;
  opacity: 0.55;
  right: 8px;
  top: 6px;
  padding: 0 8px;
  border-radius: 10px;
  background: rgba(127, 127, 127, 0.15);
  letter-spacing: 0.5px;
  text-transform: lowercase;   /* 顺带把 JSON 显示成 json；去掉这行就是大写 */
}